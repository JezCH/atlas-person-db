{
  "schema": "atlas-spatial-fact-contract/v1",
  "historical_fact": {
    "entity": "PolityPlaceFunction",
    "identity": [
      "polity_id",
      "function_type",
      "place_id",
      "start_year",
      "end_year"
    ],
    "required": [
      "polity_id",
      "function_type",
      "place_id",
      "confidence",
      "source_refs"
    ],
    "function_types": [
      "capital",
      "royal_court",
      "royal_residence",
      "imperial_court_core",
      "political_center",
      "administrative_center"
    ],
    "rules": {
      "place_id_must_reference_first_class_place": true,
      "source_refs_are_provenance_not_display_placement": true,
      "macroregion_subregion_are_not_historical_fact_fields": true,
      "unknown_boundary_may_be_null": true,
      "source_refs_must_use_source_uuid_and_locator": true,
      "repository_place_function_records_are_derived_projection": true,
      "place_name_and_region_code_are_projection_only": true
    },
    "canonical_authority": [
      "atlas_v2.polity_place_functions",
      "atlas_v2.polity_place_function_sources"
    ],
    "authoritative_writer": "server/atlas-polity-place-function-service.js#createPolityPlaceFunction"
  },
  "display_disposition": {
    "entity": "SpatialDisplayDisposition",
    "allowed_kinds": [
      "static_geography",
      "review_queue",
      "activity_override"
    ],
    "fields": [
      "region_code",
      "subregion_code",
      "location_label",
      "reason"
    ],
    "rules": {
      "must_not_masquerade_as_polity_place_function": true,
      "review_queue_is_explicit_hold": true,
      "activity_override_is_display_only": true,
      "place_function_projection_path": "spatial/projections/polity-place-functions.v1.json"
    }
  },
  "registration_handshake": {
    "applies_when": "new_polity",
    "required_terminal_states": [
      "existing_disposition",
      "reviewed_static",
      "reviewed_place_function",
      "reviewed_hold"
    ],
    "silent_omission_forbidden": true,
    "done_requires_materialized_reviewed_disposition": true,
    "request_materialized_flag_is_authority": false,
    "materialization_authority": "atlas_v2.spatial_registration_dispositions",
    "materialization_rule": "A reviewed request supplies state/evidence only; the canonical registration writer persists and exact-read-backs the disposition before DONE."
  },
  "p14_boundary": {
    "contract": "contracts/p14-territory-geometry-contract.v2.json",
    "rule": "PolityPlaceFunction and SpatialDisplayDisposition do not imply TerritoryRecord or Geometry; territorial authority exists only through DB-backed canonical P14 Authoring under Person -> Activity -> Polity -> TerritoryRecord -> Geometry."
  }
}
