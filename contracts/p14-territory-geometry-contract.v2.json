{
  "schema": "atlas-p14-territory-geometry-contract/v2",
  "version": 2,
  "chain": [
    "Person",
    "Activity",
    "Polity",
    "TerritoryRecord",
    "Geometry"
  ],
  "authority": {
    "geometry_tables": [
      "atlas_v2.geometries",
      "atlas_v2.geometry_sources"
    ],
    "territory_tables": [
      "atlas_v2.territory_records",
      "atlas_v2.territory_record_sources"
    ],
    "writer": "server/atlas-p14-territory-geometry-service.js",
    "identity_rule": "UUID is canonical identity; semantic/repository references are lookup keys only."
  },
  "temporal": {
    "vocabulary_source": "contracts/stage2-domain-contract.v1.json#temporal",
    "unresolved_boundary": "all-null year/month/day/granularity/certainty/calendar tuple",
    "ongoing_end": "all-null end boundary plus chronology_status=ongoing and ongoing_as_of review date",
    "year_zero_forbidden": true,
    "fabricated_boundary_forbidden": true
  },
  "geometry": {
    "required": [
      "geometry_kind",
      "geometry_ref",
      "source_refs"
    ],
    "geometry_kinds": [
      "point",
      "line",
      "polygon",
      "multipolygon"
    ],
    "source_ref_shape": [
      "source_id",
      "locator"
    ],
    "rules": {
      "historical_authority_forbidden": true,
      "person_id_forbidden": true,
      "polity_id_forbidden": true,
      "activity_id_forbidden": true,
      "control_type_forbidden": true,
      "temporal_fields_forbidden": true,
      "geometry_is_reusable_evidence_backed_shape": true,
      "invented_geometry_forbidden": true,
      "display_requirement_cannot_create_geometry": true,
      "source_refs_must_use_source_uuid_and_locator": true
    }
  },
  "territory_record": {
    "identity": [
      "polity_id",
      "geometry_id",
      "control_type",
      "valid_start boundary",
      "valid_end boundary",
      "chronology_status"
    ],
    "required": [
      "polity_id",
      "geometry_id",
      "control_type",
      "boundary_certainty",
      "evidence_confidence",
      "chronology_status",
      "source_refs"
    ],
    "control_types": [
      "sovereign_control",
      "de_facto_control",
      "tributary_control",
      "occupied_control",
      "contested_control",
      "administrative_control",
      "other_reviewed_control"
    ],
    "boundary_certainty": [
      "exact",
      "approximate",
      "disputed",
      "partial",
      "unknown"
    ],
    "evidence_confidence": [
      "well_established",
      "probable",
      "uncertain"
    ],
    "chronology_status": [
      "reviewed",
      "ongoing"
    ],
    "source_ref_shape": [
      "source_id",
      "locator"
    ],
    "rules": {
      "polity_is_only_political_authority_owner": true,
      "person_id_forbidden": true,
      "activity_id_forbidden": true,
      "display_fields_forbidden": [
        "region_code",
        "subregion_code",
        "location_label"
      ],
      "source_refs_must_use_source_uuid_and_locator": true,
      "valid_interval_uses_stage2_temporal_vocabulary": true,
      "unknown_boundary_may_be_all_null": true,
      "ongoing_requires_review_date": true
    }
  },
  "publication": {
    "historical_authority_path": "Person -> Activity -> Polity -> TerritoryRecord -> Geometry",
    "person_owned_geometry_forbidden": true,
    "display_only_spatial_disposition_is_not_territorial_authority": true,
    "missing_territory_must_remain_missing_or_review_hold": true,
    "bulk_gis_content_is_noncore": true,
    "actual_polygon_research_is_separate_from_authoring_foundation": true
  }
}
