    "assert_governance_period": {"polity_and_governance_uuids_required_in_execution_manifest":true,"normalized_source_links_required":true},
    "assert_polity_designation": {"polity_uuid_required":true,"normalized_source_links_required":true},
    "assert_polity_identity_relation": {"predecessor_and_successor_polity_uuids_required":true,"normalized_source_links_required":true},
    "migrate_entity_context": {"target_entity_type_must_be_reviewed":true,"people_event_governance_must_not_be_implemented_as_fake_polity":true}
