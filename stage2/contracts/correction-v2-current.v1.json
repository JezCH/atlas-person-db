    "split_activity": {"one_existing_activity_to_multiple_fragments":true,"survivor_fragment_must_be_declared":true,"survivor_fragment_preserves_original_activity_uuid":true,"new_fragment_activity_uuids_required_in_execution_manifest":true,"existing_source_links_copy_policy_required":true,"overlap_or_gap_requires_explicit_reviewed_policy":true},
    "retire_activity": {"exact_before_required":true,"dependent_source_and_description_handling_required":true},
