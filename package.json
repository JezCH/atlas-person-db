{
  "name": "atlas-person-db",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:requirements": "node scripts/verify-atlas-requirements.mjs",
    "test:release": "node scripts/verify-release-governance.mjs",
    "test:r0-gate": "node scripts/verify-r0-future-equivalence.mjs",
    "test:stage2-prep": "node scripts/verify-stage2-integration-prep.mjs",
    "test:stage2-contract": "node scripts/verify-stage2-domain-contract.mjs",
    "test:stage2-baseline-a": "node scripts/verify-stage2-baseline-a-capture.mjs stage2/baselines/baseline-a-current.v2.json artifacts/stage2-baseline-a-intake.json",
    "test:stage2-baseline-a-ledger": "node scripts/build-stage2-baseline-a-master-ledger.mjs --intake artifacts/stage2-baseline-a-intake.json --out artifacts/stage2-baseline-a-master-ledger.json --summary artifacts/stage2-baseline-a-master-ledger-summary.json && node scripts/build-stage2-baseline-a-work-queues.mjs --ledger artifacts/stage2-baseline-a-master-ledger.json --out artifacts/stage2-baseline-a-work-queues.json --summary artifacts/stage2-baseline-a-work-queues-summary.json",
    "test:runtime": "node scripts/verify-runtime-integrity.mjs",
    "test:schema": "node scripts/verify-schema-baseline.mjs",
    "test:stage2-schema-rehearsal": "node scripts/verify-stage2-schema-rehearsal.mjs",
    "test:stage2-provenance-rehearsal": "node scripts/verify-stage2-provenance-rehearsal.mjs",
    "test:stage2-entity-boundaries": "node scripts/verify-stage2-entity-boundaries-rehearsal.mjs",
    "test:stage2-semantic-key-rehearsal": "node scripts/verify-stage2-activity-semantic-key.mjs"
  },
  "dependencies": {
    "pg": "^8.18.0"
  }
}
