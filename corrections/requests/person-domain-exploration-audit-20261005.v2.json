    "edge_case_notes": [
      {
        "canonical_name_en": "Al-Masudi",
        "disposition": "move_to_culture",
        "basis": "Al-Masudi traveled extensively, but Encyclopaedia Iranica identifies him primarily as a tenth-century historian and geographer, and his surviving works are major historical-cultural syntheses. Under v2, history is explicitly culture; travel is supporting method rather than the representative identity.",
        "sources": [
          "https://www.iranicaonline.org/articles/masudi/",
          "https://www.iranicaonline.org/articles/historiography-iii/"
        ]
      },
      {
        "canonical_name_en": "Al-Idrisi",
        "disposition": "move_to_science",
        "basis": "Al-Idrisi traveled, but his durable identity is geographer and cartographer. The Library of Congress describes his major achievement as a systematic work of medieval geography combining inherited knowledge with observations and traveler reports. That formal geographic/cartographic inquiry fits science more directly than exploration.",
        "sources": [
          "https://www.loc.gov/resource/gdcwdl.wdl_18418/?sp=9&st=list"
        ]
      },
      {
        "canonical_name_en": "Francis Drake",
        "disposition": "retain_exploration",
        "basis": "Drake was also a privateer and naval commander, but Royal Museums Greenwich explicitly treats him as an Elizabethan explorer and centers his successful 1577–1580 circumnavigation. Exploration remains the strongest single representative domain.",
        "sources": [
          "https://www.rmg.co.uk/collections/objects/rmgc-object-14077",
          "https://www.rmg.co.uk/collections/objects/rmgc-object-14136"
        ]
      },
      {
        "canonical_name_en": "Samuel de Champlain",
        "disposition": "retain_exploration",
        "basis": "Champlain also founded Quebec and performed colonial administrative functions, but Parks Canada identifies him nationally as explorer, founder of Quebec and father of New France, and emphasizes repeated Atlantic crossings, mapping and inland exploration. Exploration remains representative.",
        "sources": [
          "https://parks.canada.ca/lhn-nhs/qc/saintlouisforts/culture/histoire-history/personnage-person",
          "https://parks.canada.ca/lhn-nhs/ns/portroyal/culture/personnes-people"
        ]
      },
      {
        "canonical_name_en": "Hasekura Tsunenaga",
        "disposition": "retain_exploration",
        "basis": "Hasekura was a diplomatic envoy rather than a ruler. UNESCO's Memory of the World record centers the seven-year trans-Pacific and trans-Atlantic Keicho mission. Because governance is reserved for political power or rule while exploration explicitly includes expeditions and frontier travel, exploration remains the closest canonical sector.",
        "sources": [
          "https://media.unesco.org/sites/default/files/webform/mow001/japan_spain_keicho.pdf",
          "https://www.unesco.org/es/memory-world/materials-related-keicho-era-mission-europe-japan-and-spain"
        ]
      },
      {
        "canonical_name_en": "Jonathan Lambert",
        "disposition": "retain_exploration",
        "basis": "Lambert proclaimed sovereignty, but the official Tristan da Cunha historical account primarily records him as leader of the first attempted settlement and a remote trading-station venture. The unrecognized sovereignty claim does not outweigh his frontier-settlement identity.",
        "sources": [
          "https://www.tristandc.com/history1506-1817.php",
          "https://tristandc.com/po/stamps202407.php"
        ]
      },
      {
        "canonical_name_en": "Osborne Russell",
        "disposition": "retain_exploration",
        "basis": "Russell later served in Oregon's provisional government, but his durable historical identity is the mountain-man/trapper frontier career preserved in Journal of a Trapper; National Park Service material repeatedly uses Russell as a primary witness to western travel and trapping. Brief political office therefore does not override exploration/frontier identity.",
        "sources": [
          "https://npgallery.nps.gov/GetAsset/4fee6836-0a61-47b2-a9f5-c6779a469177",
          "https://www.nps.gov/yell/learn/upload/YS_16_3_sm.pdf"
        ]
      },
      {
        "canonical_name_en": "Amelia Earhart",
        "disposition": "retain_exploration",
        "basis": "Earhart was an aviator rather than an engineer or inventor; her representative record is record-setting long-distance flight and attempted global circumnavigation. Exploration's frontier-travel scope is the closest fit.",
        "sources": [
          "https://airandspace.si.edu/collection-objects/amelia-earhart/nasm_A19500108000"
        ]
      },
      {
        "canonical_name_en": "Yuri Gagarin",
        "disposition": "retain_exploration",
        "basis": "Gagarin's defining historical act is the first human orbital spaceflight. Spaceflight as a frontier expedition is directly within exploration rather than military service or science alone.",
        "sources": [
          "https://science.nasa.gov/resource/yuri-gagarin-first-human-in-space/"
        ]
      },
      {
        "canonical_name_en": "Neil Armstrong",
        "disposition": "retain_exploration",
        "basis": "Armstrong was an engineer and test pilot, but his durable global historical identity is Apollo 11 commander and first person to walk on the Moon. The bounded lunar expedition makes exploration the strongest single representative domain.",
        "sources": [
          "https://www.nasa.gov/mission/apollo-11/"
        ]
      },
      {
        "canonical_name_en": "Kupe",
        "disposition": "retain_exploration",
        "basis": "Kupe is kept out of the ordinary timeline because the Person record is legendary_possible_historical_core, but the traditional identity itself is explicitly voyaging, discovery and settlement tradition; the uncertainty affects timeline treatment, not the representative domain.",
        "sources": []
      }
    ]
