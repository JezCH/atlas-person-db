    "sources": [
      "https://whc.unesco.org/en/list/1667",
      "https://www.unesco.org/en/articles/unesco-commends-cambodia-inscription-koh-ker-world-heritage-list",
      "https://namu.wiki/w/%ED%81%AC%EB%A9%94%EB%A5%B4%20%EC%A0%9C%EA%B5%AD"
    ]
  },
  "operations": [
    {
      "type": "replace_person_preferred_name",
      "person_id": "ef6ece40-2a70-5399-b124-0c411c962d18",
      "expected_before": {
        "locale": "en",
        "name": "Yasovarman IV",
        "name_type": "canonical",
        "is_preferred": true
      },
      "expected_after": {
