    "edge_case_notes": [
      {
        "canonical_name_en": "Cecil Rhodes",
        "disposition": "move_to_governance",
        "basis": "Rhodes was a mining magnate, but his durable historical identity includes direct state leadership as Prime Minister of the Cape Colony from 1890 to 1896 and the use of political authority and a chartered company to drive territorial expansion. South African History Online describes him as businessman, Member of Parliament, Prime Minister and imperialist, and explicitly links his economic power to political control. Under v2, direct state leadership and imperial political power fit governance more strongly than enterprise alone.",
        "sources": [
          "https://sahistory.org.za/people/cecil-john-rhodes",
          "https://sahistory.org.za/archive/book-3-migration-land-and-minerals-making-south-africa-chapter-2-imperialism-and-union"
        ]
      },
      {
        "canonical_name_en": "Robert Carter I",
        "disposition": "retain_commerce",
        "basis": "Carter briefly exercised Virginia's executive authority as Council president, but his durable identity and power base were extraordinary plantation, land, tobacco, merchant, credit and proprietary wealth. Encyclopedia Virginia identifies him as the richest and one of the most powerful Virginians of his day and situates that power in the planter-merchant economy. The temporary acting governorship does not outweigh the economic identity.",
        "sources": [
          "https://encyclopediavirginia.org/entries/colonial-virginia/",
          "https://encyclopediavirginia.org/entries/governors-of-virginia/"
        ]
      },
      {
        "canonical_name_en": "John Macarthur",
        "disposition": "retain_commerce",
        "basis": "Macarthur briefly virtually administered New South Wales during the Rum Rebellion, but the Australian Dictionary of Biography identifies his long-term significance with the wool industry, grazing, trading and promotion of a colonial commercial staple. The exceptional 1808 administrative episode does not override commerce.",
        "sources": [
          "https://adb.anu.edu.au/biography/macarthur-john-2390",
          "https://adb.anu.edu.au/lifesummary/macarthur-john-2390"
        ]
      },
      {
        "canonical_name_en": "Alfred Escher",
        "disposition": "retain_commerce",
        "basis": "Escher held major political offices and thirty-four years in the National Council, but his representative legacy joins politics to founding and directing transformative rail, banking, insurance and infrastructure institutions. The Swiss Parliament itself frames his influence as simultaneously political and economic. With no national executive rulership and a durable enterprise/economic-system legacy, commerce remains the stronger single domain.",
        "sources": [
          "https://www.parlament.ch/blog/Pages/alfred-escher%E2%80%93ein-koenig-im-schweizer-parlament.aspx"
        ]
      },
      {
        "canonical_name_en": "Jang Bogo",
        "disposition": "retain_commerce",
        "basis": "Jang Bogo commanded armed maritime power, but the Academy of Korean Studies defines him as a merchant who established Cheonghaejin and led international maritime trade among Silla, Tang and Japan. Military force protected and enabled the trade network; commerce remains representative.",
        "sources": [
          "https://encykorea.aks.ac.kr/Article/E0048474"
        ]
      },
      {
        "canonical_name_en": "Tippu Tip",
        "disposition": "retain_commerce",
        "basis": "Tippu Tip exercised regional political control, but his historical identity is inseparable from the ivory and slave-trading network and trading state that generated that authority. The political role does not erase the enterprise/trade identity, so commerce remains the best single sector.",
        "sources": []
      },
      {
        "canonical_name_en": "Lucky Luciano",
        "disposition": "retain_commerce",
        "basis": "Luciano led organized crime rather than a state or polity. The FBI describes him as structuring La Cosa Nostra like a corporation and dividing rackets among families. Governance is reserved for political or state rule; enterprise, even illicit enterprise, is therefore closer to commerce under the present eight-sector taxonomy.",
        "sources": [
          "https://www.fbi.gov/history/cases-and-criminals/la-cosa-nostra"
        ]
      },
      {
        "canonical_name_en": "Elinor Ostrom",
        "disposition": "retain_commerce",
        "basis": "Ostrom was a political scientist, but her Nobel-recognized representative contribution is analysis of economic governance, especially the commons. The taxonomy explicitly assigns economic systems or thought to commerce when representative.",
        "sources": [
          "https://www.nobelprize.org/prizes/economic-sciences/2009/press-release/"
        ]
      }
    ]
